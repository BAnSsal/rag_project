# Copy this file to .env and fill in real values.

# If set, the project uses real OpenAI embeddings + chat model.
# If left empty, it automatically falls back to a deterministic
# offline "fake" provider so the pipeline still runs (useful for
# demos, tests, and CI without network access or an API key).
OPENAI_API_KEY=

# Models used when OPENAI_API_KEY is set.
OPENAI_CHAT_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Directory of source documents to index.
RAG_DATA_DIR=data

# Where the built FAISS index is persisted.
RAG_STORAGE_DIR=storage

# Chunking knobs.
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150

# Number of chunks retrieved per question.
RAG_TOP_K=4
